{
    // F5 w VS Code. "Demo" działa bez bazy, "Serwer" wymaga pliku .env z MONGODB_URI.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Demo (bez bazy)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/demo.js",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Serwer (MongoDB z .env)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Testy",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["test"],
            "console": "integratedTerminal"
        }
    ]
}
