# Skopiuj do .env (lokalnie) albo wpisz w Render -> Environment.

# Baza: MongoDB Atlas -> Connect -> Drivers. Hasło NIGDY nie trafia do repozytorium.
MONGODB_URI=mongodb+srv://user:haslo@klaster.mongodb.net/zuzel-typer
ADMIN_PASSWORD=dlugie-losowe-haslo-admina
PORT=3000

# Sezon, którym stemplowane są dane z wersji 1 (jednorazowa migracja)
LEGACY_SEASON=2026

# --- Powiadomienia push (PWA) --- wygeneruj: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj@email.pl
# Ile minut przed blokadą typów wysłać przypomnienie
REMINDER_MINUTES=120

# --- Scraper wyników (półautomat: admin zatwierdza) ---
# Adresy stron z wynikami Ekstraligi, oddzielone spacją lub przecinkiem.
SCRAPER_URLS=
SCRAPE_INTERVAL_MINUTES=60
# Brać pod uwagę mecze, które zaczęły się co najmniej X min temu (żeby nie złapać wyniku na żywo)
SCRAPE_MIN_AGE_MINUTES=150
SCRAPE_MAX_AGE_DAYS=14

# --- Zadania w tle ---
# Sekret dla POST /api/cron/run (GitHub Actions / cron-job.org budzą uśpiony serwer)
CRON_SECRET=
# false = wyłącza setInterval w procesie (gdy używasz tylko zewnętrznego crona)
ENABLE_SCHEDULER=true

# Opcjonalnie: dozwolone originy CORS (domyślnie aplikacja działa tylko pod własną domeną)
CORS_ORIGIN=
