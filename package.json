{
  "name": "zuzel-typer",
  "version": "3.0.0",
  "description": "Żużlowy Typer - typer Ekstraligi dla znajomych (wieloseznowy)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/scoring.test.js && node test/api.test.js && node test/scenarios.test.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i src/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/app.css -o public/css/app.css --watch",
    "vapid": "web-push generate-vapid-keys",
    "icons": "node scripts/make-icons.js",
    "demo": "node scripts/demo.js",
    "test:unit": "node test/scoring.test.js",
    "test:api": "node test/api.test.js",
    "test:scenarios": "node test/scenarios.test.js",
    "test:e2e": "node test/e2e.test.js",
    "symulacja": "node scripts/symulacja.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
